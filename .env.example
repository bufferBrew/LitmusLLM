# ---------------------------------------------------------------------------
# LitmusLLM configuration. Copy to `.env` and fill in what you need.
#   cp .env.example .env
# Everything here has a working default EXCEPT the cloud API keys, which are
# only needed if you want to compare against flagship cloud models.
# ---------------------------------------------------------------------------

# --- Ollama ---------------------------------------------------------------
# Native API (used for /api/tags, /api/pull, /api/delete).
OLLAMA_HOST=http://localhost:11434
# OpenAI-compatible endpoint (used for all generation + judging).
LOCAL_MODEL_BASE_URL=http://localhost:11434/v1
# Ollama ignores the key, but the OpenAI-compatible protocol requires one.
LOCAL_MODEL_API_KEY=ollama

# --- Defaults -------------------------------------------------------------
# Judge model used when the UI doesn't override it. Must be a model you have
# pulled. Bigger judges are markedly more reliable at emitting valid JSON --
# 7B+ is the practical floor, 14B is comfortable.
LITMUSLLM_DEFAULT_JUDGE=llama3.1:latest

# Max concurrent in-flight requests per model. Local models are memory-bound,
# so keep this low; cloud models can take more.
LITMUSLLM_LOCAL_CONCURRENCY=2
LITMUSLLM_CLOUD_CONCURRENCY=4

# Generation settings for the model *under test*.
LITMUSLLM_MAX_TOKENS=512
LITMUSLLM_TEMPERATURE=0.0
# Per-request timeout in seconds. Large local models on CPU can be slow.
LITMUSLLM_REQUEST_TIMEOUT=300

# SQLite location (relative paths resolve against the project root).
LITMUSLLM_DB_PATH=data/litmusllm.db

# DeepEval phones home with anonymous usage stats by default. This app is
# local-first, so we opt out. Set to NO if you'd rather leave it on.
DEEPEVAL_TELEMETRY_OPT_OUT=YES

# --- Cloud model API keys (all optional) ----------------------------------
# The /compare page greys out any flagship model whose key is missing.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
TOGETHER_API_KEY=
